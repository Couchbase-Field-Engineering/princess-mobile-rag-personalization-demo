{
  "expo": {
    "name": "Royal Caribbean Demo",
    "slug": "rccl-mobile-personalization",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rccldemo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1A3F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.couchbase.demo.rcclpersonalization",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A1A3F"
      },
      "package": "com.couchbase.demo.rcclpersonalization",
      "versionCode": 1,
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugin.config.js",
      "./plugin.fmt.js",
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "15.1" },
          "android": { "minSdkVersion": 24, "usesCleartextTraffic": true }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
