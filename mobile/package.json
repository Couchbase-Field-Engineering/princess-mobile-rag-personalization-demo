{
  "name": "pcl-mobile-personalization",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:ios": "expo start --dev-client --localhost --ios",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "export:web": "expo export --platform web",
    "export:web:docker": "EXPO_PUBLIC_API_URL=same-origin EXPO_PUBLIC_DB_ENGINE=preview expo export --platform web --output-dir web-dist && tar czf ../web/dist.tgz -C web-dist .",
    "typecheck": "tsc --noEmit",
    "postinstall": "bash scripts/fetch-cbl-native.sh"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "cbl-reactnative": "github:Fujio-Turner/cbl-reactnative#feat/vector-search-support",
    "expo": "~52.0.49",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.2",
    "expo-dev-client": "~5.0.20",
    "expo-font": "~13.0.4",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.22",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.9",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  }
}
