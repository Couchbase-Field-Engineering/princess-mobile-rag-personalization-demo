{
  "name": "guest_personalization_daily_export",
  "description": "Daily export of passenger reservation personalization data (Guest 360 + model scores) for the Royal Caribbean mobile app. Output is picked up by the demo backend, loaded into Couchbase (synced to Couchbase Lite) and published to the Couchbase Agent Operations Manager Knowledge Base.",
  "schedule": {
    "quartz_cron_expression": "0 0 5 * * ?",
    "timezone_id": "America/New_York",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "timeout_seconds": 5400,
  "email_notifications": {
    "on_failure": ["guest-data-platform@example.com"]
  },
  "tasks": [
    {
      "task_key": "export_guest_personalization",
      "notebook_task": {
        "notebook_path": "/Repos/rccl/royal-caribbean-mobile-rag-personalization-demo/databricks/notebooks/guest_personalization_daily_export",
        "base_parameters": {
          "catalog": "rccl_prod",
          "schema": "guest360",
          "export_volume": "/Volumes/rccl_prod/guest360/exports/passenger_reservation_personalization",
          "horizon_days": "150",
          "num_files": "4"
        },
        "source": "WORKSPACE"
      },
      "job_cluster_key": "export_cluster",
      "max_retries": 2,
      "min_retry_interval_millis": 300000
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "export_cluster",
      "new_cluster": {
        "spark_version": "16.4.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 4,
        "data_security_mode": "SINGLE_USER",
        "runtime_engine": "PHOTON"
      }
    }
  ],
  "tags": {
    "team": "guest-data-platform",
    "consumer": "rccl-mobile-app",
    "demo": "couchbase-aom"
  }
}
